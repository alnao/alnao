# Configurazione AWS
AWS_REGION="eu-central-1"
EC2_INSTANCE_ID=""
SECURITY_GROUP_ID="sg-xxxxxx"
PEM_PATH="/home/user/.aws/key.pem"
EC2_KEY_NAME="key"

# Dimensionamento istanza EC2 (consigliato t3.medium per Paperclip con Docker)
INSTANCE_TYPE="t3.medium"
EBS_VOLUME_SIZE_GB="30"

# Nomi delle risorse (Tag Name)
EC2_INSTANCE_NAME="alnao-paperclip-ec2"
EBS_VOLUME_NAME="alnao-paperclip-ebs"
ENI_NAME="alnao-paperclip-eni"

# I 6 Tag (incluso Name sopra): Environment, Project, Owner, CostCenter, ManagedBy
TAG_ENVIRONMENT="dev"
TAG_PROJECT="Paperclip"
TAG_OWNER="AlNao"
TAG_COST_CENTER="dev"
TAG_MANAGED_BY="Sh"

# Percorso Log
LOG_PATH="/home/user/.aws/paperclip_server.log"

# Configurazione Paperclip
PAPERCLIP_PORT="3100"
PAPERCLIP_DEPLOYMENT_MODE="authenticated" # "authenticated" oppure "local_trusted"
PAPERCLIP_DEPLOYMENT_EXPOSURE="private"   # "private" oppure "public"

# Provider LLM (imposta almeno una chiave API per il funzionamento degli agenti)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
