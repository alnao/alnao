# ==============================================================================
# Configurazione Paperclip AI - Ambiente Locale Docker
# ==============================================================================

# Porta su cui esporre la Web UI e API di Paperclip
PAPERCLIP_PORT=3100

# Percorso del disco / volume esterno per persistenza di DB, task, workspace agenti
# Può essere una directory su disco esterno (es. /mnt/Dati4/paperclip_data)
# oppure una sottocartella locale (es. ./data)
PAPERCLIP_DATA_DIR="/mnt/Dati4/paperclip_data"

# Modalità di autenticazione:
# - "local_trusted": accesso immediato senza credenziali (consigliato per uso locale)
# - "authenticated": richiede registrazione/login amministratore con password
PAPERCLIP_DEPLOYMENT_MODE="authenticated"
PAPERCLIP_DEPLOYMENT_EXPOSURE="private"
PAPERCLIP_PUBLIC_URL="http://localhost:3100"

# Provider LLM (imposta almeno una chiave API per l'esecuzione degli agenti)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Secret crittografici (lasciare vuoti: lo script di avvio li genererà e salverà automaticamente al primo avvio)
BETTER_AUTH_SECRET=""
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=""
